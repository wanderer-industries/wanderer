<div class="flex h-full w-full min-h-0 flex-col pl-14">
  <header class="flex min-h-16 shrink-0 items-center justify-between gap-6 border-b border-neutral-800 bg-neutral-900/70 px-6 py-3">
    <div class="min-w-0">
      <h1 class="text-base font-semibold text-neutral-100">Maps</h1>
      <p class="mt-0.5 text-xs text-neutral-500">Manage and open your available maps</p>
    </div>

    <div class="flex min-w-0 flex-1 items-center justify-end gap-3">
      <div :if={not @restrict_maps_creation?} class="shrink-0">
        <.link
          patch={~p"/maps/new"}
          class="inline-flex h-9 items-center overflow-hidden rounded border border-neutral-700 border-l-4 border-l-orange-300/60 bg-neutral-900 text-sm font-medium text-neutral-100 transition-colors hover:border-neutral-600 hover:border-l-orange-200 hover:bg-neutral-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-300"
          aria-label="Create map"
          title="Create map"
        >
          <span class="flex h-full w-8 items-center justify-center text-orange-200">
            <.icon name="hero-plus-solid" class="size-4" />
          </span>
          <span class="border-l border-neutral-700 px-3">New Map</span>
        </.link>

        <%!--
          Saved design reference: dashed segmented create-map button.

          <.link
            patch={~p"/maps/new"}
            class="inline-flex h-9 shrink-0 items-center overflow-hidden rounded border border-dashed border-orange-300/45 bg-orange-950/10 text-sm font-medium text-neutral-100 transition-colors hover:border-orange-200/80 hover:bg-orange-300/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-300"
            aria-label="Create map"
            title="Create map - dashed segmented"
          >
            <span class="flex h-full w-9 items-center justify-center border-r border-dashed border-orange-300/35 text-orange-200">
              <.icon name="hero-plus-solid" class="size-4" />
            </span>
            <span class="px-3">Create</span>
          </.link>
        --%>
      </div>

      <span
        :if={not @restrict_maps_creation?}
        class="h-6 w-px shrink-0 bg-neutral-700"
        aria-hidden="true"
      />

      <div
        id="map-view-switcher"
        phx-hook="MapViewPreference"
        data-current-view-mode={@map_view_mode}
        class="flex h-9 shrink-0 items-center overflow-hidden rounded border border-neutral-700 bg-neutral-900 p-0.5 [&>button+button]:border-l [&>button+button]:border-neutral-700"
        role="group"
        aria-label="Map view"
      >
        <button
          :for={option <- map_view_options()}
          type="button"
          phx-click="set-map-view"
          phx-value-mode={option.value}
          data-map-view-mode={option.value}
          aria-label={option.label}
          aria-pressed={@map_view_mode == option.mode}
          title={option.label}
          class={[
            "flex size-7 items-center justify-center text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-orange-300",
            @map_view_mode == option.mode && "bg-orange-300/15 text-orange-200"
          ]}
        >
          <.icon name={option.icon} class="size-4" />
        </button>
      </div>
    </div>
  </header>

  <main class="min-h-0 w-full flex-1 overflow-auto bg-black/20 p-6">
    <div :if={@map_view_mode == :cards}>
      <.async_result :let={maps} :if={assigns[:maps]} assign={@maps}>
        <:loading>
          <div class="h-40 animate-pulse rounded border border-dashed border-orange-300/35 bg-neutral-950" />
        </:loading>
        <:failed :let={reason}>{reason}</:failed>
        <div class="overflow-x-auto rounded border border-dashed border-orange-300/45 bg-neutral-950 shadow-sm shadow-black/30">
          <table class="w-full min-w-[1100px] text-left text-sm [&_td]:align-middle">
            <thead class="border-b border-dashed border-orange-300/35 bg-orange-300/[0.04] text-[10px] uppercase tracking-[0.16em] text-neutral-500">
              <tr>
                <th class="px-3 py-2 font-medium text-neutral-300">Map</th>
                <th class="w-20 border-l border-dashed border-orange-300/15 px-3 py-2 text-center font-medium">
                  Active
                </th>
                <th class="w-48 border-l border-dashed border-orange-300/15 px-3 py-2 font-medium">
                  Scope
                </th>
                <th class="border-l border-dashed border-orange-300/15 px-3 py-2 font-medium">
                  Description
                </th>
                <th class="w-80 border-l border-dashed border-orange-300/15 px-3 py-2 font-medium">
                  Access lists
                </th>
                <th class="w-px whitespace-nowrap border-l border-dashed border-orange-300/15 px-3 py-2 text-right font-medium">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-dashed divide-orange-300/25">
              <tr
                :for={{map, index} <- Enum.with_index(maps, 1)}
                class="h-12 transition-colors duration-300 hover:bg-orange-300/[0.035]"
              >
                <td class="max-w-72 px-3 py-2">
                  <div class="flex min-w-0 items-center gap-2">
                    <span class="shrink-0 text-[10px] font-medium tracking-[0.16em] text-orange-200">
                      {index |> Integer.to_string() |> String.pad_leading(2, "0")}
                    </span>
                    <span class="h-5 w-px shrink-0 bg-neutral-700" aria-hidden="true" />
                    <.link
                      navigate={~p"/#{map.slug}"}
                      class="min-w-0 truncate font-semibold text-neutral-100 hover:text-orange-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange-300"
                      title={map.name}
                    >
                      {map.name}
                    </.link>
                    <.link
                      navigate={~p"/#{map.slug}"}
                      class="flex size-6 shrink-0 items-center justify-center text-orange-200/40 transition-colors duration-300 hover:text-orange-200 focus-visible:text-orange-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange-300"
                      aria-label={"Open #{map.name}"}
                      title="Open map"
                    >
                      <.icon name="hero-arrow-top-right-on-square-solid" class="h-5 w-[1.25em]" />
                    </.link>
                  </div>
                </td>
                <td class="w-20 border-l border-dashed border-orange-300/15 px-3 py-2 text-center">
                  <WandererAppWeb.Maps.MapCardVariants.active_count map={map} />
                </td>
                <td class="w-48 border-l border-dashed border-orange-300/15 px-3 py-2 text-[10px] tracking-[0.14em] text-neutral-400">
                  <WandererAppWeb.Maps.MapCardVariants.scope_path map={map} compact />
                </td>
                <td class="max-w-80 border-l border-dashed border-orange-300/15 px-3 py-2">
                  <p class="truncate text-xs text-neutral-500" title={map.description}>
                    {map.description}
                  </p>
                </td>
                <td class="w-80 border-l border-dashed border-orange-300/15 px-3 py-2">
                  <WandererAppWeb.Maps.MapCardVariants.acl_tags
                    map={map}
                    current_user={@current_user}
                    limit={3}
                  />
                </td>
                <td class="w-px whitespace-nowrap border-l border-dashed border-orange-300/15 px-3 py-2">
                  <WandererAppWeb.Maps.MapCardVariants.map_actions
                    map={map}
                    current_user={@current_user}
                    prefix="compact-table-map"
                    compact
                    borderless
                  />
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </.async_result>
    </div>

    <div :if={@map_view_mode == :compact}>
      <.async_result :let={maps} :if={assigns[:maps]} assign={@maps}>
        <:loading>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,380px),430px))] gap-x-5 gap-y-7">
            <div
              :for={index <- 1..6}
              id={"map-card-variant-skeleton-#{index}"}
              class="h-64 animate-pulse rounded border border-neutral-800 bg-neutral-900"
            />
          </div>
        </:loading>
        <:failed :let={reason}>{reason}</:failed>
        <div
          :if={maps != []}
          class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,380px),430px))] items-start gap-x-5 gap-y-7"
        >
          <WandererAppWeb.Maps.MapCardVariants.card
            :for={{map, index} <- Enum.with_index(maps, 1)}
            map={map}
            index={index}
            current_user={@current_user}
          />
        </div>
      </.async_result>
    </div>
  </main>
</div>

<.modal
  :if={@is_connected? && @live_action == :create}
  title="Create Map"
  class="!flex !h-[min(694px,calc(100vh-2rem))] !w-[760px] !flex-col [&>.p-dialog-content]:!flex [&>.p-dialog-content]:!min-h-0 [&>.p-dialog-content]:!flex-1 [&>.p-dialog-content]:!flex-col [&>.p-dialog-content]:!px-7 [&>.p-dialog-content]:!py-5 [&>.p-dialog-header]:!shrink-0 [&>.p-dialog-header]:!px-7 [&>.p-dialog-header]:!py-2 [&>.p-dialog-header>.p-dialog-header-close]:relative [&>.p-dialog-header>.p-dialog-header-close]:-right-5"
  id="add_map_modal"
  show
  on_cancel={JS.patch(~p"/maps")}
>
  <div
    class="mb-4 flex shrink-0 border-b border-neutral-700"
    role="tablist"
    aria-label="Create map sections"
  >
    <button
      type="button"
      role="tab"
      aria-selected={@active_create_tab == "common"}
      phx-click="change_create_tab"
      phx-value-tab="common"
      class={[
        "inline-flex items-center gap-2 border-b-2 px-4 py-2 text-sm transition-colors",
        classes(
          "border-sky-400 bg-neutral-800/70 text-sky-400": @active_create_tab == "common",
          "border-transparent text-neutral-400 hover:text-neutral-200":
            @active_create_tab != "common"
        )
      ]}
    >
      <.icon name="hero-pencil-square-solid" class="size-4 shrink-0" />
      <span>Common</span>
    </button>
    <button
      type="button"
      role="tab"
      aria-selected={@active_create_tab == "access_lists"}
      phx-click="change_create_tab"
      phx-value-tab="access_lists"
      class={[
        "inline-flex items-center gap-2 border-b-2 px-4 py-2 text-sm transition-colors",
        classes(
          "border-sky-400 bg-neutral-800/70 text-sky-400": @active_create_tab == "access_lists",
          "border-transparent text-neutral-400 hover:text-neutral-200":
            @active_create_tab != "access_lists"
        )
      ]}
    >
      <.icon name="hero-key-solid" class="size-4 shrink-0" />
      <span>Access Lists</span>
    </button>
  </div>
  <.form
    :let={f}
    id="create-map-form"
    for={@form}
    phx-change="validate"
    phx-submit={@live_action}
    autocomplete="off"
    class={[
      "min-h-0 flex-1 flex-col",
      classes(flex: @active_create_tab == "common", hidden: @active_create_tab != "common")
    ]}
  >
    <div class="custom-scrollbar min-h-0 flex-1 overflow-y-auto pr-2 [&_.label-text-alt>span]:hidden [&_.label-text-alt]:before:mr-1 [&_.label-text-alt]:before:content-['*'] [&>label.form-control>.inputContainer]:mb-1">
      <div class="grid grid-cols-2 items-start gap-4 [&>label.form-control>.inputContainer]:mb-0.5 [&>label.form-control>.label]:h-6 [&>label.form-control>.label]:py-0.5">
        <.input type="text" field={f[:name]} label="Map Name" placeholder="Map Name" />
        <.input
          type="text"
          field={f[:slug]}
          label="Map Slug"
          prefix={@uri}
          placeholder="map-slug"
        />
      </div>
      <.input
        type="textarea"
        field={f[:description]}
        label="Public description"
        placeholder="Public description"
      />
      <WandererAppWeb.Maps.MapSettings.SettingsSelect.select
        field={f[:owner_id]}
        label="Map owner *"
        options={Enum.map(@characters, fn character -> {character.label, character.id} end)}
        prompt="Select a map owner"
        wrapper_class="mt-2"
      />
      <div class="mt-4 flex items-center gap-3">
        <span class="shrink-0 text-xs font-normal uppercase tracking-wide text-stone-500">
          Automatically tracked space types
        </span>
        <div class="h-px flex-1 border-t border-stone-700" />
      </div>
      <div class="mt-1 grid grid-cols-1 gap-x-8 sm:grid-cols-2">
        <%= for scope_option <- @available_scopes do %>
          <% is_checked = scope_option.value in (get_current_scopes(f) || []) %>
          <label class="grid cursor-pointer grid-cols-[auto_1fr_auto] items-center py-1.5">
            <div class="order-3 flex items-center">
              <div
                class={[
                  "checkboxRoot sizeM p-checkbox p-component",
                  if(is_checked, do: "p-highlight", else: "")
                ]}
                data-p-highlight={is_checked}
                data-p-disabled="false"
                data-pc-name="checkbox"
                data-pc-section="root"
              >
                <input
                  type="checkbox"
                  name={"form[scopes][#{scope_option.value}]"}
                  value="true"
                  checked={is_checked}
                  class="p-checkbox-input"
                  aria-invalid="false"
                  data-pc-section="input"
                />
                <div
                  class="p-checkbox-box"
                  data-p-highlight={is_checked}
                  data-p-disabled="false"
                  data-pc-section="box"
                >
                  <svg
                    :if={is_checked}
                    width="14"
                    height="14"
                    viewBox="0 0 14 14"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="p-icon p-checkbox-icon"
                    aria-hidden="true"
                    data-pc-section="icon"
                  >
                    <path
                      d="M4.86199 11.5948C4.78717 11.5923 4.71366 11.5745 4.64596 11.5426C4.57826 11.5107 4.51779 11.4652 4.46827 11.4091L0.753985 7.69483C0.683167 7.64891 0.623706 7.58751 0.580092 7.51525C0.536478 7.44299 0.509851 7.36177 0.502221 7.27771C0.49459 7.19366 0.506156 7.10897 0.536046 7.03004C0.565935 6.95111 0.613367 6.88 0.674759 6.82208C0.736151 6.76416 0.8099 6.72095 0.890436 6.69571C0.970973 6.67046 1.05619 6.66385 1.13966 6.67635C1.22313 6.68886 1.30266 6.72017 1.37226 6.76792C1.44186 6.81567 1.4997 6.8786 1.54141 6.95197L4.86199 10.2503L12.6397 2.49483C12.7444 2.42694 12.8689 2.39617 12.9932 2.40745C13.1174 2.41873 13.2343 2.47141 13.3251 2.55705C13.4159 2.64268 13.4753 2.75632 13.4938 2.87973C13.5123 3.00315 13.4888 3.1292 13.4271 3.23768L5.2557 11.4091C5.20618 11.4652 5.14571 11.5107 5.07801 11.5426C5.01031 11.5745 4.9368 11.5923 4.86199 11.5948Z"
                      fill="currentColor"
                    >
                    </path>
                  </svg>
                </div>
              </div>
            </div>
            <span class="order-1 select-none text-[13px] text-neutral-300">
              {scope_option.label}
            </span>
            <div class="order-2 mx-3 h-px border-b-2 border-dotted border-neutral-700" />
          </label>
        <% end %>
      </div>
      <div class="mt-4 flex items-center gap-3">
        <span class="shrink-0 text-xs font-normal uppercase tracking-wide text-stone-500">
          Access restrictions
        </span>
        <div class="h-px flex-1 border-t border-stone-700" />
      </div>
      <div class="grid grid-cols-1 gap-x-8 sm:grid-cols-2">
        <.input
          type="checkbox"
          field={f[:only_tracked_characters]}
          label="Allow only tracked characters"
        />
        <.input
          type="checkbox"
          field={f[:create_default_acl]}
          label="Create default access list"
          checked={
            Phoenix.HTML.Form.normalize_value("checkbox", f[:create_default_acl].value) == true or
              is_nil(f[:create_default_acl].value)
          }
        />
      </div>
    </div>
    <div class="mt-4 flex shrink-0 items-center justify-end">
      <.button
        class="inline-flex items-center justify-center gap-2 !rounded-sm !px-4 !py-2"
        type="submit"
      >
        <.icon name="hero-plus-solid" class="h-4 w-4 shrink-0" />
        <span>Create map</span>
      </.button>
    </div>
  </.form>
  <div :if={@active_create_tab == "access_lists"} class="flex min-h-0 flex-1 flex-col">
    <div class="min-h-0 flex-1">
      <WandererAppWeb.Maps.MapSettings.AccessListsTab.content
        access_lists={@acls}
        selected_ids={@selected_access_list_ids}
        saved_ids={@saved_access_list_ids}
        marked_ids={@marked_access_list_ids}
        search={@access_list_search}
        search_focused={@access_list_search_focused}
      />
    </div>
    <div class="mt-4 flex shrink-0 items-center justify-end">
      <.button
        form="create-map-form"
        class="inline-flex items-center justify-center gap-2 !rounded-sm !px-4 !py-2"
        type="submit"
      >
        <.icon name="hero-plus-solid" class="h-4 w-4 shrink-0" />
        <span>Create map</span>
      </.button>
    </div>
  </div>
</.modal>

<.modal
  :if={@live_action in [:settings] && not is_nil(assigns[:map])}
  title="Map Settings"
  class="mapSettingsDialog"
  id="map-settings-modal"
  show
  on_cancel={JS.patch(~p"/maps")}
>
  <div class="mapSettingsLayout">
    <div class="verticalTabsContainer">
      <div class="p-tabview p-component" data-pc-name="tabview" data-pc-section="root">
        <div class="p-tabview-nav-container" data-pc-section="navcontainer">
          <div class="p-tabview-nav-content" data-pc-section="navcontent">
            <ul class="p-tabview-nav" role="tablist" data-pc-section="nav">
              <li
                class={[
                  "p-unselectable-text",
                  classes("p-tabview-selected p-highlight": @active_settings_tab == "common")
                ]}
                role="presentation"
                data-pc-section="header"
              >
                <a
                  role="tab"
                  class="p-tabview-nav-link flex p-[10px]"
                  tabindex="0"
                  aria-selected={@active_settings_tab == "common"}
                  data-pc-section="headeraction"
                  phx-click="change_settings_tab"
                  phx-value-tab="common"
                >
                  <span
                    class="p-tabview-title inline-flex items-center gap-1 leading-none"
                    data-pc-section="headertitle"
                  >
                    <.icon name="hero-pencil-square-solid" class="h-4 w-4 shrink-0" />
                    <span>Common</span>
                  </span>
                </a>
              </li>

              <li
                class={[
                  "p-unselectable-text",
                  classes("p-tabview-selected p-highlight": @active_settings_tab == "general")
                ]}
                role="presentation"
                data-pc-name=""
                data-pc-section="header"
              >
                <a
                  role="tab"
                  class="p-tabview-nav-link flex p-[10px]"
                  tabindex="-1"
                  aria-controls="pr_id_330_content"
                  aria-selected={@active_settings_tab == "general"}
                  aria-disabled="false"
                  data-pc-section="headeraction"
                  phx-click="change_settings_tab"
                  phx-value-tab="general"
                >
                  <span
                    class="p-tabview-title inline-flex items-center gap-1 leading-none"
                    data-pc-section="headertitle"
                  >
                    <.icon name="hero-wrench-screwdriver-solid" class="h-4 w-4 shrink-0" />
                    <span>Settings</span>
                  </span>
                </a>
              </li>

              <li
                class={[
                  "p-unselectable-text",
                  classes(
                    "p-tabview-selected p-highlight": @active_settings_tab == "access_lists"
                  )
                ]}
                role="presentation"
                data-pc-section="header"
              >
                <a
                  role="tab"
                  class="p-tabview-nav-link flex p-[10px]"
                  tabindex="-1"
                  aria-selected={@active_settings_tab == "access_lists"}
                  data-pc-section="headeraction"
                  phx-click="change_settings_tab"
                  phx-value-tab="access_lists"
                >
                  <span
                    class="p-tabview-title inline-flex items-center gap-1 leading-none"
                    data-pc-section="headertitle"
                  >
                    <.icon name="hero-key-solid" class="h-4 w-4 shrink-0" />
                    <span>Access Lists</span>
                  </span>
                </a>
              </li>

              <li
                :if={@map_subscriptions_enabled?}
                class={[
                  "p-unselectable-text",
                  classes("p-tabview-selected p-highlight": @active_settings_tab == "balance")
                ]}
                role="presentation"
                data-pc-name=""
                data-pc-section="header"
              >
                <a
                  role="tab"
                  class="p-tabview-nav-link flex p-[10px]"
                  tabindex="-1"
                  aria-controls="pr_id_332_content"
                  aria-selected="false"
                  aria-disabled="false"
                  data-pc-section="headeraction"
                  phx-click="change_settings_tab"
                  phx-value-tab="balance"
                >
                  <span
                    class="p-tabview-title inline-flex items-center gap-1 leading-none"
                    data-pc-section="headertitle"
                  >
                    <.icon name="hero-banknotes-solid" class="h-4 w-4 shrink-0" />
                    <span>Balance</span>
                  </span>
                </a>
              </li>

              <li
                :if={@map_subscriptions_enabled?}
                class={[
                  "p-unselectable-text",
                  classes(
                    "p-tabview-selected p-highlight": @active_settings_tab == "subscription"
                  )
                ]}
                role="presentation"
                data-pc-name=""
                data-pc-section="header"
              >
                <a
                  role="tab"
                  class="p-tabview-nav-link flex p-[10px]"
                  tabindex="-1"
                  aria-controls="pr_id_334_content"
                  aria-selected="false"
                  aria-disabled="false"
                  data-pc-section="headeraction"
                  phx-click="change_settings_tab"
                  phx-value-tab="subscription"
                >
                  <span
                    class="p-tabview-title inline-flex items-center gap-1 leading-none"
                    data-pc-section="headertitle"
                  >
                    <.icon name="hero-check-badge-solid" class="h-4 w-4 shrink-0" />
                    <span>Subscription</span>
                  </span>
                </a>
              </li>

              <li
                class={[
                  "p-unselectable-text",
                  classes("p-tabview-selected p-highlight": @active_settings_tab == "import")
                ]}
                role="presentation"
                data-pc-name=""
                data-pc-section="header"
              >
                <a
                  role="tab"
                  class="p-tabview-nav-link flex p-[10px]"
                  tabindex="-1"
                  aria-controls="pr_id_331_content"
                  aria-selected="false"
                  aria-disabled="false"
                  data-pc-section="headeraction"
                  phx-click="change_settings_tab"
                  phx-value-tab="import"
                >
                  <span
                    class="p-tabview-title inline-flex items-center gap-1 leading-none"
                    data-pc-section="headertitle"
                  >
                    <.icon name="hero-document-arrow-down-solid" class="h-4 w-4 shrink-0" />
                    <span>Import/Export</span>
                  </span>
                </a>
              </li>
              <li
                :if={not WandererApp.Env.public_api_disabled?()}
                class={[
                  "p-unselectable-text",
                  classes("p-tabview-selected p-highlight": @active_settings_tab == "public_api")
                ]}
                role="presentation"
                data-pc-name=""
                data-pc-section="header"
              >
                <a
                  role="tab"
                  class="p-tabview-nav-link flex p-[10px]"
                  tabindex="-1"
                  aria-controls="pr_id_335_content"
                  aria-selected="false"
                  aria-disabled="false"
                  data-pc-section="headeraction"
                  phx-click="change_settings_tab"
                  phx-value-tab="public_api"
                >
                  <span
                    class="p-tabview-title inline-flex items-center gap-1 leading-none"
                    data-pc-section="headertitle"
                  >
                    <.icon name="hero-globe-alt-solid" class="h-4 w-4 shrink-0" />
                    <span>Public Api</span>
                  </span>
                </a>
              </li>
              <li
                :if={@map_subscriptions_enabled?}
                class={[
                  "p-unselectable-text",
                  classes("p-tabview-selected p-highlight": @active_settings_tab == "bot")
                ]}
                role="presentation"
                data-pc-name=""
                data-pc-section="header"
              >
                <a
                  role="tab"
                  class="p-tabview-nav-link flex p-[10px]"
                  tabindex="-1"
                  aria-controls="pr_id_335_content"
                  aria-selected="false"
                  aria-disabled="false"
                  data-pc-section="headeraction"
                  phx-click="change_settings_tab"
                  phx-value-tab="bot"
                >
                  <span
                    class="p-tabview-title inline-flex items-center gap-1 leading-none"
                    data-pc-section="headertitle"
                  >
                    <.icon name="hero-puzzle-piece-solid" class="h-4 w-4 shrink-0" />
                    <span>Bots</span>
                  </span>
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="p-tabview-panels" data-pc-section="panelcontainer">
          <div
            id="pr_id_330_content"
            class="p-tabview-panel"
            role="tabpanel"
            aria-labelledby="pr_id_33_header_0"
            data-pc-name=""
            data-pc-section="content"
          >
            <WandererAppWeb.Maps.MapSettings.CommonTab.content
              :if={@active_settings_tab == "common"}
              form={@form}
              uri={@uri}
              characters={@characters}
              available_scopes={@available_scopes}
            />

            <WandererAppWeb.Maps.MapSettings.AccessListsTab.content
              :if={@active_settings_tab == "access_lists"}
              access_lists={@acls}
              selected_ids={@selected_access_list_ids}
              saved_ids={@saved_access_list_ids}
              marked_ids={@marked_access_list_ids}
              search={@access_list_search}
              search_focused={@access_list_search_focused}
            />

            <div
              :if={@active_settings_tab == "general"}
              class="mapSettingsScrollableTab custom-scrollbar"
            >
              <WandererAppWeb.Maps.MapSettings.GeneralTab.content form={@options_form} />
            </div>

            <div
              :if={@active_settings_tab == "import"}
              class="mapSettingsScrollableTab custom-scrollbar"
            >
              <WandererAppWeb.Maps.MapSettings.ImportExportTab.content
                form={@import_form}
                importing={@importing}
                map_slug={@map_slug}
                export_settings={@export_settings}
              />
            </div>

            <div
              :if={@active_settings_tab == "bot"}
              class="mapSettingsScrollableTab custom-scrollbar"
            >
              <WandererAppWeb.Maps.MapSettings.BotsTab.content map_id={@map.id} />
            </div>

            <div
              :if={
                @active_settings_tab == "public_api" and
                  not WandererApp.Env.public_api_disabled?()
              }
              class="mapSettingsScrollableTab custom-scrollbar"
            >
              <WandererAppWeb.Maps.MapSettings.PublicApiTab.content
                public_api_key={@public_api_key}
                sse_enabled={@sse_enabled}
                sse_can_enable={@sse_can_enable}
                sse_unavailable_reason={@sse_unavailable_reason}
              />
            </div>

            <div
              :if={@active_settings_tab == "balance"}
              class="mapSettingsScrollableTab custom-scrollbar"
            >
              <.live_component
                module={WandererAppWeb.Maps.MapBalanceComponent}
                id="map-balance-component"
                map_id={@map.id}
                notify_to={self()}
                event_name="balance_event"
                current_user={@current_user}
              />
            </div>

            <div
              :if={@active_settings_tab == "subscription"}
              class="mapSettingsScrollableTab custom-scrollbar"
            >
              <.live_component
                module={WandererAppWeb.Maps.MapSubscriptionsComponent}
                id="map-subscriptions-component"
                map_id={@map.id}
                notify_to={self()}
                event_name="subscriptions_event"
                current_user={@current_user}
                readonly={false}
              />
            </div>
          </div>

          <div
            :if={@active_settings_tab == "common"}
            class="mapSettingsPanelFooter flex items-center justify-end gap-2"
          >
            <.button
              type="button"
              severity="error"
              class="py-[4px]"
              phx-click="reset_common_settings"
            >
              Reset
            </.button>
            <.button
              type="submit"
              form="map-settings-common-form"
              outlined={false}
              class="py-[4px]"
            >
              Save
            </.button>
          </div>

          <div
            :if={@active_settings_tab == "access_lists"}
            class="mapSettingsPanelFooter flex items-center justify-end gap-2"
          >
            <.button
              type="button"
              severity="error"
              class="py-[4px]"
              phx-click="reset_access_lists"
            >
              Reset
            </.button>
            <.button type="button" outlined={false} class="py-[4px]" phx-click="save_access_lists">
              Save
            </.button>
          </div>
        </div>
      </div>
    </div>
  </div>
</.modal>
