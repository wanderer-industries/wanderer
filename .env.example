# How many days chain passages (jumps through connections) are kept (optional, default 7)
# A daily job deletes passages not updated for longer than this; must be a positive integer
# export WANDERER_MAP_CHAIN_PASSAGES_RETENTION_DAYS="7"

# How many days system signatures are kept (optional, default 14)
